# Proxmox接続情報
# このファイルをコピーして .env ファイルを作成し、実際の値を設定してください
# cp .env.example .env

# Proxmox エンドポイント
PROXMOX_VE_ENDPOINT=https://192.168.1.2:8006/

# Proxmox API トークン
# 形式: username@realm!tokenid=secret
PROXMOX_VE_API_TOKEN=terraform-prov@pve!terraform-token=your-secret-here

# 自己署名証明書を使用する場合は true
PROXMOX_VE_INSECURE=true
